# GEMINI_API_KEY: Required for AI features (image scan, cost prediction).
# Without this the app still works: component suggestions use a built-in dictionary.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (Cloud Run injects this automatically).
APP_URL="MY_APP_URL"

# DB_PATH: Where to store the JSON database file.
# Default: data/db.json (relative to project root).
# For Cloud Run with persistent storage, mount a GCS bucket at /data and set:
# DB_PATH="/data/db.json"
# DB_PATH="data/db.json"

# PORT: Server port. Cloud Run sets this automatically to 8080.
# PORT=3000
